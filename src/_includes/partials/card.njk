{%- set pc = post.data.category | category(categories) %}
<article class="card" style="--cat: {{ pc.color }}">
  <a class="card-media" href="{{ post.url }}" tabindex="-1" aria-hidden="true">
    <img src="{{ post.data.image or ('/assets/img/categories/' + pc.slug + '.svg') }}" alt="" width="600" height="260" loading="{{ 'eager' if (loop and loop.index <= 3) else 'lazy' }}" decoding="async">
  </a>
  <div class="card-body">
    <a class="card-cat" href="/category/{{ pc.slug }}/">{{ pc.short }}</a>
    {%- set ch = cardHeading or "h3" %}<{{ ch }} class="card-title"><a href="{{ post.url }}">{{ post.data.title }}</a></{{ ch }}>
    <p class="card-desc">{{ post.data.description }}</p>
    <p class="card-meta"><time datetime="{{ post.date | ymd }}">{{ post.date | readableDate }}</time> · {{ post.content | readingTime }} min read</p>
  </div>
</article>
