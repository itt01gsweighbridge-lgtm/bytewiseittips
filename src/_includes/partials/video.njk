{#- Privacy-friendly YouTube embed: nothing loads from YouTube except the thumbnail image until the visitor clicks play.
    The player then loads from youtube-nocookie.com. Requires `v` = { id, title }. -#}
<figure class="yt" data-yt="{{ v.id }}">
  <button type="button" class="yt-play" aria-label="Play video: {{ v.title }}">
    <img src="https://i.ytimg.com/vi/{{ v.id }}/hqdefault.jpg" alt="" width="480" height="360" loading="lazy" decoding="async">
    <span class="yt-icon" aria-hidden="true"><svg viewBox="0 0 68 48" width="68" height="48"><path d="M66.5 7.7a8.5 8.5 0 0 0-6-6C55.3.3 34 .3 34 .3s-21.3 0-26.5 1.4a8.5 8.5 0 0 0-6 6C.1 13 .1 24 .1 24s0 11 1.4 16.3a8.5 8.5 0 0 0 6 6C12.7 47.7 34 47.7 34 47.7s21.3 0 26.5-1.4a8.5 8.5 0 0 0 6-6C67.9 35 67.9 24 67.9 24s0-11-1.4-16.3z" fill="#f00"/><path d="M27 34V14l18 10z" fill="#fff"/></svg></span>
  </button>
  <figcaption><a href="https://www.youtube.com/watch?v={{ v.id }}" rel="noopener" target="_blank">{{ v.title }}</a> <span class="yt-note">· Plays from YouTube when you click</span></figcaption>
</figure>
