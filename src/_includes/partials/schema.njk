{%- set orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": site.url + "/#organization",
  "name": site.name,
  "url": site.url + "/",
  "logo": { "@type": "ImageObject", "url": "/assets/img/logo-512.png" | absoluteUrl, "width": 512, "height": 512 },
  "email": site.owner.contactEmail,
  "founder": { "@type": "Person", "@id": site.url + "/author/#person", "name": author.personName },
  "sameAs": [site.social.youtube] | reject("falsy")
} %}
{%- if page.url == "/" or page.url == "/about/" or page.url == "/contact/" %}
<script type="application/ld+json">{{ orgSchema | json | safe }}</script>
{%- endif %}
{%- if page.url == "/author/" %}
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "mainEntity": {
    "@type": "Person",
    "@id": site.url + "/author/#person",
    "name": author.personName,
    "jobTitle": author.personJobTitle,
    "description": author.personBio,
    "knowsAbout": author.expertise,
    "url": "/author/" | absoluteUrl,
    "worksFor": { "@id": site.url + "/#organization" }
  }
} | json | safe }}</script>
{%- endif %}
{%- if breadcrumbs %}
{%- set crumbItems = [] %}
{%- for b in breadcrumbs %}
{%- set crumbItems = (crumbItems.push({ "@type": "ListItem", "position": loop.index, "name": b.label, "item": (b.url | absoluteUrl) }), crumbItems) %}
{%- endfor %}
<script type="application/ld+json">{{ { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": crumbItems } | json | safe }}</script>
{%- endif %}
{%- if isArticle %}
{%- set cat = category | category(categories) %}
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": title,
  "description": description,
  "image": [("/assets/img/og/" + category + ".jpg") | absoluteUrl],
  "datePublished": page.date | isoDate,
  "dateModified": updated | isoDate,
  "inLanguage": site.language,
  "articleSection": cat.name,
  "keywords": (keywords or []) | join(", "),
  "mainEntityOfPage": { "@type": "WebPage", "@id": page.url | absoluteUrl },
  "author": { "@type": "Organization", "name": author.name, "url": "/author/" | absoluteUrl },
  "editor": { "@type": "Person", "@id": site.url + "/author/#person", "name": author.personName, "url": "/author/" | absoluteUrl },
  "publisher": { "@type": "Organization", "@id": site.url + "/#organization", "name": site.name, "url": site.url + "/", "logo": { "@type": "ImageObject", "url": "/assets/img/logo-512.png" | absoluteUrl } }
} | json | safe }}</script>
{%- endif %}
