---
layout: layouts/base.njk
pagination:
  data: collections.articles
  size: 12
  alias: pagePosts
permalink: "/articles/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}"
eleventyComputed:
  title: "All Articles{% if pagination.pageNumber > 0 %} – Page {{ pagination.pageNumber + 1 }}{% endif %}"
  description: "Browse every ByteWise IT Tips guide: Windows, networking, Microsoft 365, cybersecurity, Android, software, AI tools and buying advice{% if pagination.pageNumber > 0 %} (page {{ pagination.pageNumber + 1 }}){% endif %}."
  breadcrumbs:
    - { label: "Home", url: "/" }
    - { label: "All Articles", url: "/articles/" }
---
<div class="page-hero">
  <div class="container">
    {% include "partials/breadcrumbs.njk" %}
    <h1>All articles</h1>
    <p class="lede">{{ collections.articles.length }} practical guides, newest first.</p>
  </div>
</div>
<section class="section">
  <div class="container">
    <nav class="chip-row" aria-label="Filter by category">
      <a href="/articles/" aria-current="page">All</a>
      {%- for c in categories %}<a href="/category/{{ c.slug }}/">{{ c.short }}</a>{% endfor %}
    </nav>
    {% set cardHeading = "h2" %}<div class="card-grid">
      {%- for post in pagePosts %}{% include "partials/card.njk" %}{% endfor %}
    </div>
    {%- if pagination.pages.length > 1 %}
    <nav class="pagination" aria-label="Pagination">
      {%- if pagination.href.previous %}<a href="{{ pagination.href.previous }}" rel="prev">← Newer</a>{% endif %}
      {%- for href in pagination.hrefs %}
      <a href="{{ href }}"{% if loop.index0 == pagination.pageNumber %} aria-current="page"{% endif %}>{{ loop.index }}</a>
      {%- endfor %}
      {%- if pagination.href.next %}<a href="{{ pagination.href.next }}" rel="next">Older →</a>{% endif %}
    </nav>
    {%- endif %}
  </div>
</section>
