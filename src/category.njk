---
layout: layouts/base.njk
pagination:
  data: categories
  size: 1
  alias: cat
permalink: "/category/{{ cat.slug }}/"
eleventyComputed:
  title: "{{ cat.name }} Guides"
  description: "{{ cat.description }}"
  category: "{{ cat.slug }}"
  breadcrumbs:
    - { label: "Home", url: "/" }
    - { label: "Categories", url: "/categories/" }
    - { label: "{{ cat.short }}", url: "/category/{{ cat.slug }}/" }
---
{%- set list = collections.articles | byCategory(cat.slug) %}
<div class="page-hero" style="background:linear-gradient(180deg,color-mix(in srgb,{{ cat.color }} 10%,var(--bg-soft)),var(--bg-soft))">
  <div class="container">
    {% include "partials/breadcrumbs.njk" %}
    <h1>{{ cat.name }}</h1>
    <p class="lede">{{ cat.description }}</p>
    <p class="page-updated">{{ list.length }} guide{% if list.length != 1 %}s{% endif %} in this category</p>
  </div>
</div>
<section class="section">
  <div class="container">
    <nav class="chip-row" aria-label="Other categories">
      <a href="/articles/">All</a>
      {%- for c in categories %}<a href="/category/{{ c.slug }}/"{% if c.slug == cat.slug %} aria-current="page"{% endif %}>{{ c.short }}</a>{% endfor %}
    </nav>
    {% set cardHeading = "h2" %}<div class="card-grid">{% for post in list %}{% include "partials/card.njk" %}{% endfor %}</div>
  </div>
</section>
